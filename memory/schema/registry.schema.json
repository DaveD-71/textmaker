{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DaveD-71/textmaker/memory/schema/registry.schema.json",
  "title": "Textmaker memory source registry",
  "type": "object",
  "required": ["schema_version", "repository_id", "baseline_commit", "scope_registry", "sources", "artifacts", "generated"],
  "properties": {
    "schema_version": {"const": 1},
    "repository_id": {"type": "string", "minLength": 1},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope_registry": {"type": "string", "minLength": 1},
    "pilot_scope": {"type": "string"},
    "device_id": {"type": "string", "minLength": 1},
    "clone_id": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "generated": {"type": "object"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["path", "kind", "authority", "lifecycle", "scope_ids"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "authority": {"enum": ["authoritative", "derived", "generated"]},
        "lifecycle": {"enum": ["current", "legacy-active", "historical", "retired"]},
        "scope_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
