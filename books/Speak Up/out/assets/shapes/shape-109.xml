art</ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:szCs ns0:val="20" /><ns0:lang ns0:val="en-US" /></ns0:rPr><ns0:t>’</ns0:t></ns0:r><ns0:r ns0:rsidRPr="008F4FCC"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:szCs ns0:val="20" /><ns0:lang ns0:val="en-US" /></ns0:rPr><ns0:t>s name.</ns0:t></ns0:r></ns0:p><ns0:p ns2:paraId="1465415D" ns2:textId="30227961" ns0:rsidR="005F3A45" ns0:rsidRPr="008F4FCC" ns0:rsidRDefault="00386A52" ns0:rsidP="008F4FCC"><ns0:pPr><ns0:spacing ns0:after="0" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:szCs ns0:val="20" /><ns0:lang ns0:val="en-US" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="008F4FCC"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:szCs ns0:val="20" /><ns0:lang ns0:val="en-US" /></ns0:rPr><ns0:t>It’s important when we meet people to catch their names and use them in conversation.</ns0:t></ns0:r></ns0:p></ns0:txbxContent></ns1:textbox><ns4:wrap anchorx="page" anchory="page" /></ns1:shape></ns0:pict>