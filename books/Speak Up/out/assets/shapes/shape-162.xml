:t xml:space="preserve">A: </ns0:t></ns0:r><ns0:r ns0:rsidRPr="0052653F"><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>I will meet Asuka on Sunday</ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>.</ns0:t></ns0:r></ns0:p><ns0:p ns2:paraId="5BF10977" ns2:textId="77777777" ns0:rsidR="005F3A45" ns0:rsidRPr="0052653F" ns0:rsidRDefault="00386A52" ns0:rsidP="00C44411"><ns0:pPr><ns0:spacing ns0:after="120" /><ns0:ind ns0:left="357" /><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr></ns0:pPr><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t xml:space="preserve">B: </ns0:t></ns0:r><ns0:r ns0:rsidRPr="0052653F"><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>Asuka?</ns0:t></ns0:r></ns0:p><ns0:p ns2:paraId="490509F3" ns2:textId="77777777" ns0:rsidR="005F3A45" ns0:rsidRPr="009065B3" ns0:rsidRDefault="00386A52" ns0:rsidP="00C44411"><ns0:pPr><ns0:snapToGrid ns0:val="0" /><ns0:spacing ns0:before="240" ns0:after="240" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr></ns0:pPr><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>U</ns0:t></ns0:r><ns0:r ns0:rsidRPr="009065B3"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>sually</ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>, we</ns0:t></ns0:r><ns0:r ns0:rsidRPr="009065B3"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t xml:space="preserve"> repeat the most interesting information. </ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>Here</ns0:t></ns0:r><ns0:r ns0:rsidRPr="009065B3"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t xml:space="preserve"> ‘Asuka’ is repeated, but we could also repeat ‘Sunday?’, or even ‘You?’</ns0:t></ns0:r></ns0:p><ns0:p ns2:paraId="615B8272" ns2:textId="77777777" ns0:rsidR="005F3A45" ns0:rsidRPr="009065B3" ns0:rsidRDefault="00386A52" ns0:rsidP="00C44411"><ns0:pPr><ns0:spacing ns0:after="0" ns0:line="240" ns0:lineRule="auto" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:b /><ns0:bCs /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="009065B3"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:b /><ns0:bCs /></ns0:rPr><ns0:t>With a partner, practice making comments and repeating key words.</ns0:t></ns0:r></ns0:p></ns0:txbxContent></ns1:textbox><ns4:wrap anchorx="page" /></ns1:shape></ns0:pict>