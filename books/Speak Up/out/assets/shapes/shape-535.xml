l="002060" /><ns0:sz ns0:val="24" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="002F1D81"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:b /><ns0:color ns0:val="002060" /><ns0:sz ns0:val="24" /></ns0:rPr><ns0:t>Can You Help Me?</ns0:t></ns0:r></ns0:p><ns0:p ns2:paraId="2B374A07" ns2:textId="77777777" ns0:rsidR="005F3A45" ns0:rsidRDefault="00386A52" ns0:rsidP="007576D9"><ns0:pPr><ns0:spacing ns0:after="240" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr></ns0:pPr><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t xml:space="preserve">Think of a problem you have to deal with. It can be real, or imaginary. </ns0:t></ns0:r></ns0:p><ns0:p ns2:paraId="7944C9D1" ns2:textId="77777777" ns0:rsidR="005F3A45" ns0:rsidRDefault="00386A52" ns0:rsidP="007576D9"><ns0:pPr><ns0:pStyle ns0:val="ListParagraph" /><ns0:numPr><ns0:ilvl ns0:val="0" /><ns0:numId ns0:val="45" /></ns0:numPr><ns0:spacing ns0:after="120" /><ns0:ind ns0:left="357" ns0:hanging="357" /><ns0:contextualSpacing ns0:val="0" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="007576D9"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t xml:space="preserve">Explain the problem to a partner, and then ask them to propose some ideas which can help you solve the problem. </ns0:t></ns0:r></ns0:p><ns0:p ns2:paraId="5795268C" ns2:textId="0B70965B" ns0:rsidR="005F3A45" ns0:rsidRPr="007576D9" ns0:rsidRDefault="00386A52" ns0:rsidP="007576D9"><ns0:pPr><ns0:pStyle ns0:val="ListParagraph" /><ns0:numPr><ns0:ilvl ns0:val="0" /><ns0:numId ns0:val="45" /></ns0:numPr><ns0:spacing ns0:after="0" /><ns0:ind ns0:left="357" ns0:hanging="357" /><ns0:contextualSpacing ns0:val="0" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="007576D9"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>Decide whether you will accept their ideas. If you do not, explain why not.</ns0:t></ns0:r></ns0:p></ns0:txbxContent></ns1:textbox><ns4:wrap anchorx="page" /></ns1:shape></ns0:pict>