" ns0:rsidRDefault="00386A52" ns0:rsidP="007E7D02"><ns0:pPr><ns0:snapToGrid ns0:val="0" /><ns0:spacing ns0:line="259" ns0:lineRule="auto" /><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /><ns0:sz ns0:val="24" /><ns0:szCs ns0:val="24" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="00EF5E37"><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>I agree. I think the modern furniture, the use of sofas and the large open cafeteria will make it a relaxing place to work. I think our employees will look forward to going to work.</ns0:t></ns0:r></ns0:p></ns0:tc></ns0:tr><ns0:tr ns0:rsidR="00705512" ns0:rsidRPr="00EF5E37" ns5:paraId="6D67BDEC" ns5:textId="77777777" ns0:rsidTr="007E7D02"><ns0:trPr><ns0:tblCellSpacing ns0:w="56" ns0:type="dxa" /><ns0:jc ns0:val="right" /></ns0:trPr><ns0:tc><ns0:tcPr><ns0:tcW ns0:w="1533" ns0:type="dxa" /></ns0:tcPr><ns0:p ns5:paraId="42385268" ns5:textId="77777777" ns0:rsidR="005F3A45" ns0:rsidRPr="008F2CCE" ns0:rsidRDefault="00386A52" ns0:rsidP="007E7D02"><ns0:pPr><ns0:snapToGrid ns0:val="0" /><ns0:spacing ns0:line="259" ns0:lineRule="auto" /><ns0:jc ns0:val="right" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" ns0:cs="Calibri" /><ns0:b /><ns0:bCs /><ns0:color ns0:val="002060" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="008F2CCE"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:b /><ns0:bCs /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>Julia</ns0:t></ns0:r></ns0:p></ns0:tc><ns0:tc><ns0:tcPr><ns0:tcW ns0:w="7145" ns0:type="dxa" /><ns0:shd ns0:val="clear" ns0:color="auto" ns0:fill="FFFFFF" ns0:themeFill="background1" /><ns0:vAlign ns0:val="center" /></ns0:tcPr><ns0:p ns5:paraId="05BE379A" ns5:textId="77777777" ns0:rsidR="005F3A45" ns0:rsidRPr="00EF5E37" ns0:rsidRDefault="00386A52" ns0:rsidP="007E7D02"><ns0:pPr><ns0:snapToGrid ns0:val="0" /><ns0:spacing ns0:line="259" ns0:lineRule="au