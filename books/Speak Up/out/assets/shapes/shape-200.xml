i="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>your head.</ns0:t></ns0:r></ns0:p><ns0:p ns2:paraId="0A2EE4BF" ns2:textId="11F94E2D" ns0:rsidR="005F3A45" ns0:rsidRPr="00A364C4" ns0:rsidRDefault="00386A52" ns0:rsidP="009D77D2"><ns0:pPr><ns0:numPr><ns0:ilvl ns0:val="0" /><ns0:numId ns0:val="48" /></ns0:numPr><ns0:snapToGrid ns0:val="0" /><ns0:spacing ns0:after="120" ns0:line="240" ns0:lineRule="auto" /><ns0:ind ns0:left="357" ns0:hanging="357" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:color ns0:val="002060" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="00342138"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:b /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>Personal space</ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t xml:space="preserve">. </ns0:t></ns0:r><ns0:r ns0:rsidRPr="00A364C4"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>Keep near to and facing your counterpart (but not too near).</ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t xml:space="preserve"> Personal space limits vary between cultures.</ns0:t></ns0:r></ns0:p><ns0:p ns2:paraId="440A27C3" ns2:textId="77777777" ns0:rsidR="005F3A45" ns0:rsidRPr="00942AE1" ns0:rsidRDefault="00386A52" ns0:rsidP="00C44411"><ns0:pPr><ns0:spacing ns0:before="240" ns0:after="0" ns0:line="240" ns0:lineRule="auto" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="00942AE1"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>When we focus on what we say in communication, we sometimes forget the importance of what we</ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t xml:space="preserve"> share but</ns0:t></ns0:r><ns0:r ns0:rsidRPr="00942AE1"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t xml:space="preserve"> do not say. It’s important to remember that communication includes both verbal and non-verbal exchanges of information.</ns0:t></ns0:r></ns0:p></ns0:txbxContent></ns1:textbox><ns4:wrap anchorx="page" anchory="page" /></ns1:roundrect></ns0:pict>