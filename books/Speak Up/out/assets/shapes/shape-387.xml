<ns0:drawing xmlns:ns0="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:ns1="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:ns2="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:ns3="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:ns4="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" xmlns:ns5="http://schemas.microsoft.com/office/word/2010/wordml"><ns1:anchor distT="45720" distB="45720" distL="114300" distR="114300" simplePos="0" relativeHeight="251994112" behindDoc="0" locked="0" layoutInCell="1" allowOverlap="1" ns2:anchorId="296718F5" ns2:editId="7A558F97"><ns1:simplePos x="0" y="0" /><ns1:positionH relativeFrom="page"><ns1:posOffset>2463800</ns1:posOffset></ns1:positionH><ns1:positionV relativeFrom="page"><ns1:posOffset>720090</ns1:posOffset></ns1:positionV><ns1:extent cx="4679950" cy="4686300" /><ns1:effectExtent l="57150" t="57150" r="330200" b="323850" /><ns1:wrapNone /><ns1:docPr id="1163" name="TB Advice" /><ns1:cNvGraphicFramePr><ns3:graphicFrameLocks /></ns1:cNvGraphicFramePr><ns3:graphic><ns3:graphicData uri="http://schemas.microsoft.com/office/word/2010/wordprocessingShape"><ns4:wsp><ns4:cNvSpPr txBox="1"><ns3:spLocks noChangeArrowheads="1" /></ns4:cNvSpPr><ns4:spPr bwMode="auto"><ns3:xfrm><ns3:off x="0" y="0" /><ns3:ext cx="4679950" cy="4686300" /></ns3:xfrm><ns3:prstGeom prst="roundRect"><ns3:avLst /></ns3:prstGeom><ns3:solidFill><ns3:srgbClr val="FFF2CC" /></ns3:solidFill><ns3:ln w="19050"><ns3:noFill /><ns3:headEnd /><ns3:tailEnd /></ns3:ln><ns3:effectLst><ns3:outerShdw blurRad="190500" dist="228600" dir="2700000" algn="ctr"><ns3:srgbClr val="000000"><ns3:alpha val="30000" /></ns3:srgbClr></ns3:outerShdw></ns3:effectLst><ns3:scene3d><ns3:camera prst="orthographicFront"><ns3:rot lat="0" lon="0" rev="0" /></ns3:camera><ns3:lightRig rig="glow" dir="t"><ns3:rot lat="0" lon="0" rev="4800000" /></ns3:lightRig></ns3:scene3d><ns3:sp3d prstMaterial="matte"><ns3:bevelT w="127000" h="63500" /></ns3:sp3d></ns4:spPr><ns4:style><ns3:lnRef idx="2"><ns3:schemeClr val="accent1" /></ns3:lnRef><ns3:fillRef idx="1"><ns3:schemeClr val="lt1" /></ns3:fillRef><ns3:effectRef idx="0"><ns3:schemeClr val="accent1" /></ns3:effectRef><ns3:fontRef idx="minor"><ns3:schemeClr val="dk1" /></ns3:fontRef></ns4:style><ns4:txbx><ns0:txbxContent><ns0:p ns5:paraId="08EA8984" ns5:textId="77777777" ns0:rsidR="005F3A45" ns0:rsidRPr="00A80452" ns0:rsidRDefault="00386A52" ns0:rsidP="001E1FE2"><ns0:pPr><ns0:shd ns0:val="clear" ns0:color="auto" ns0:fill="002060" /><ns0:spacing ns0:after="120" /><ns0:jc ns0:val="center" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:b /><ns0:color ns0:val="FFFFFF" ns0:themeColor="background1" /><ns0:sz ns0:val="24" /><ns0:lang ns0:val="en-US" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="00A80452"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /><ns0:b /><ns0:color ns0:val="FFFFFF" ns0:themeColor="background1" /><ns0:sz ns0:val="24" /><ns0:lang ns0:val="en-US" /></ns0:rPr><ns0:t>What about ‘please’?</ns0:t></ns0:r></ns0:p><ns0:p ns5:paraId="290E8FC3" ns5:textId="35D7FE25" ns0:rsidR="005F3A45" ns0:rsidRPr="006E000C" ns0:rsidRDefault="00386A52" ns0:rsidP="001E1FE2"><ns0:pPr><ns0:snapToGrid ns0:val="0" /><ns0:spacing ns0:after="120" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="006E000C"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>We can certainly make a request more polite by including ‘please’. ‘Could you open the door, please?’ is more polite than ‘Could you open the door?’</ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t xml:space="preserve"> </ns0:t></ns0:r><ns0:r ns0:rsidRPr="006E000C"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>However, just adding ‘please’ to a command does not make it a request. It just makes it a polite command, such as ‘Please open the door’.</ns0:t></ns0:r></ns0:p><ns0:p ns5:paraId="605CCC96" ns5:textId="16186D8C" ns0:rsidR="005F3A45" ns0:rsidRDefault="00386A52" ns0:rsidP="00E936C6"><ns0:pPr><ns0:snapToGrid ns0:val="0" /><ns0:spacing ns0:after="120" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="006E000C"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>With a request, the person you are asking to help you has the option to accept or reject your request. With a command, even a polite one, there is no option. The speaker expects the listener to do what he or she has said. So, a request is always more polite than a polite command.</ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t xml:space="preserve"> </ns0:t></ns0:r><ns0:r ns0:rsidRPr="006E000C"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>Look at the following</ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t xml:space="preserve"> four</ns0:t></ns0:r><ns0:r ns0:rsidRPr="006E000C"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t xml:space="preserve"> </ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>sentences:</ns0:t></ns0:r></ns0:p><ns0:tbl><ns0:tblPr><ns0:tblStyle ns0:val="TableGrid" /><ns0:tblW ns0:w="0" ns0:type="auto" /><ns0:tblBorders><ns0:top ns0:val="none" ns0:sz="0" ns0:space="0" ns0:color="auto" /><ns0:left ns0:val="none" ns0:sz="0" ns0:space="0" ns0:color="auto" /><ns0:bottom ns0:val="none" ns0:sz="0" ns0:space="0" ns0:color="auto" /><ns0:right ns0:val="none" ns0:sz="0" ns0:space="0" ns0:color="auto" /><ns0:insideH ns0:val="none" ns0:sz="0" ns0:space="0" ns0:color="auto" /><ns0:insideV ns0:val="none" ns0:sz="0" ns0:space="0" ns0:color="auto" /></ns0:tblBorders><ns0:tblCellMar><ns0:top ns0:w="85" ns0:type="dxa" /><ns0:bottom ns0:w="85" ns0:type="dxa" /></ns0:tblCellMar><ns0:tblLook ns0:val="04A0" ns0:firstRow="1" ns0:lastRow="0" ns0:firstColumn="1" ns0:lastColumn="0" ns0:noHBand="0" ns0:noVBand="1" /></ns0:tblPr><ns0:tblGrid><ns0:gridCol ns0:w="2410" /><ns0:gridCol ns0:w="2977" /></ns0:tblGrid><ns0:tr ns0:rsidR="00705512" ns0:rsidRPr="00DB2060" ns5:paraId="19373F4B" ns5:textId="77777777" ns0:rsidTr="00355658"><ns0:tc><ns0:tcPr><ns0:tcW ns0:w="2410" ns0:type="dxa" /></ns0:tcPr><ns0:p ns5:paraId="52464366" ns5:textId="4A874802" ns0:rsidR="005F3A45" ns0:rsidRPr="00DB2060" ns0:rsidRDefault="00386A52" ns0:rsidP="00E936C6"><ns0:pPr><ns0:snapToGrid ns0:val="0" /><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="00DB2060"><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>1. Come here.</ns0:t></ns0:r></ns0:p></ns0:tc><ns0:tc><ns0:tcPr><ns0:tcW ns0:w="2977" ns0:type="dxa" /></ns0:tcPr><ns0:p ns5:paraId="6C948821" ns5:textId="08BBF2CA" ns0:rsidR="005F3A45" ns0:rsidRPr="00DB2060" ns0:rsidRDefault="00386A52" ns0:rsidP="00E936C6"><ns0:pPr><ns0:snapToGrid ns0:val="0" /><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="00DB2060"><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>3. Can you come here?</ns0:t></ns0:r></ns0:p></ns0:tc></ns0:tr><ns0:tr ns0:rsidR="00705512" ns0:rsidRPr="00DB2060" ns5:paraId="06D55C16" ns5:textId="77777777" ns0:rsidTr="00355658"><ns0:tc><ns0:tcPr><ns0:tcW ns0:w="2410" ns0:type="dxa" /></ns0:tcPr><ns0:p ns5:paraId="72F39555" ns5:textId="5712B84B" ns0:rsidR="005F3A45" ns0:rsidRPr="00DB2060" ns0:rsidRDefault="00386A52" ns0:rsidP="00E936C6"><ns0:pPr><ns0:snapToGrid ns0:val="0" /><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="00DB2060"><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>2. Come here, please.</ns0:t></ns0:r></ns0:p></ns0:tc><ns0:tc><ns0:tcPr><ns0:tcW ns0:w="2977" ns0:type="dxa" /></ns0:tcPr><ns0:p ns5:paraId="05B4DED6" ns5:textId="70DC0CD3" ns0:rsidR="005F3A45" ns0:rsidRPr="00DB2060" ns0:rsidRDefault="00386A52" ns0:rsidP="00E936C6"><ns0:pPr><ns0:snapToGrid ns0:val="0" /><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="00DB2060"><ns0:rPr><ns0:rFonts ns0:ascii="Ink Free" ns0:hAnsi="Ink Free" /><ns0:color ns0:val="002060" /></ns0:rPr><ns0:t>4. Can you come here, please?</ns0:t></ns0:r></ns0:p></ns0:tc></ns0:tr></ns0:tbl><ns0:p ns5:paraId="5B8B74E7" ns5:textId="42B1CFD0" ns0:rsidR="005F3A45" ns0:rsidRPr="006E000C" ns0:rsidRDefault="00386A52" ns0:rsidP="001E1FE2"><ns0:pPr><ns0:snapToGrid ns0:val="0" /><ns0:spacing ns0:before="120" ns0:after="120" /><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr></ns0:pPr><ns0:r ns0:rsidRPr="006E000C"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t xml:space="preserve">Sentences 1 &amp; 2 are commands. Sentence 2 is more polite than Sentence 1. Sentences 3 &amp; 4 are requests. Sentence 4 is more polite than Sentence 3. </ns0:t></ns0:r><ns0:r><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>E</ns0:t></ns0:r><ns0:r ns0:rsidRPr="006E000C"><ns0:rPr><ns0:rFonts ns0:ascii="Gill Sans Nova" ns0:hAnsi="Gill Sans Nova" /></ns0:rPr><ns0:t>ven though it does not include ‘please’, Sentence 3 is more polite than Sentence 2 because Sentence 3 is a request, whereas Sentence 2 is a command.</ns0:t></ns0:r></ns0:p></ns0:txbxContent></ns4:txbx><ns4:bodyPr rot="0" vert="horz" wrap="square" lIns="108000" tIns="72000" rIns="108000" bIns="72000" anchor="t" anchorCtr="0"><ns3:noAutofit /></ns4:bodyPr></ns4:wsp></ns3:graphicData></ns3:graphic><ns2:sizeRelH relativeFrom="margin"><ns2:pctWidth>0</ns2:pctWidth></ns2:sizeRelH><ns2:sizeRelV relativeFrom="margin"><ns2:pctHeight>0</ns2:pctHeight></ns2:sizeRelV></ns1:anchor></ns0:drawing>